# Student fingerprint attendance — LAN only (do not commit real secrets)
# Devices use private IPs. Internet is NOT required for ONLINE/OFFLINE checks.
#
# Production: copy to .env on the SIS server (or use Device → Save password).
# Internal DNS / hosts file (LAN without Internet):
#   sis.slgti.ac.lk  172.16.1.245

HIKVISION_MAIN_IP=172.16.0.26
HIKVISION_READER_1_IP=172.16.0.29
HIKVISION_READER_2_IP=172.16.0.28
HIKVISION_READER_3_IP=172.16.0.27
HIKVISION_USER=admin
HIKVISION_PASS=

STUDENT_HIKVISION_IP=172.16.0.26
STUDENT_HIKVISION_USER=admin
STUDENT_HIKVISION_PASS=
STUDENT_HIKVISION_USE_HTTPS=0
STUDENT_HIKVISION_HTTP_PORT=0
STUDENT_HIKVISION_TIMEOUT=20
STUDENT_HIKVISION_READER_IPS=172.16.0.29,172.16.0.28,172.16.0.27
STUDENT_ATTENDANCE_TIMEZONE=Asia/Colombo

SIS_LAN_IP=172.16.1.245
SIS_PUBLIC_HOST=sis.slgti.ac.lk
# APP_URL_FORCE=http://172.16.1.245

# Mobitel mSMS Enterprise PHP SOAP API. Put the real password only in the server .env file.
# MOBITEL_SMS_ALIAS is the sender mask approved on the portal (this account uses SLGTI).
MOBITEL_SMS_USERNAME=esmsusr_5btHPdML
MOBITEL_SMS_PASSWORD=
MOBITEL_SMS_ALIAS=SLGTI
MOBITEL_SMS_WSDL=https://msmsenterpriseapi.mobitel.lk/mSMSEnterpriseAPI/mSMSEnterpriseAPI.wsdl
MOBITEL_SMS_MESSAGE_TYPE=0

# EDUROAM LDAP. Use the limited search account, not the directory administrator.
# Passwords are sent to LDAP only when SIS knows the plain password (a change, a new student NIC, or the staff default).
LDAP_SYNC_ENABLED=1
LDAP_HOST=127.0.0.1
LDAP_PORT=389
LDAP_STARTTLS=1
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_PEOPLE_DN=ou=People,dc=slgti,dc=ac,dc=lk
LDAP_TLS_CA=
