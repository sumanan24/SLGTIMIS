# Student fingerprint attendance machine (Hikvision ISAPI Digest)
# Optional — overrides config/student_attendance_machine.php defaults.
# Copy to .env on the server if you prefer not to keep secrets in PHP config.
# Never commit .env.

STUDENT_HIKVISION_IP=172.16.0.26
STUDENT_HIKVISION_USER=admin
STUDENT_HIKVISION_PASS=
STUDENT_HIKVISION_USE_HTTPS=0
STUDENT_HIKVISION_HTTP_PORT=0
STUDENT_HIKVISION_TIMEOUT=60
STUDENT_ATTENDANCE_TIMEZONE=Asia/Colombo
