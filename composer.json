{
    "name": "slgti/mis",
    "description": "SLGTI MIS",
    "require": {
        "php": ">=7.4 <9.0",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^1.29.0",
        "endroid/qr-code": "^4.5.2",
        "setasign/fpdf": "^2.6",
        "setasign/fpdi": "^2.6"
    },
    "config": {
        "optimize-autoloader": true,
        "platform-check": false
    },
    "suggest": {
        "ext-zip": "Required for PhpSpreadsheet to write .xlsx files (e.g. month attendance register export)."
    }
}
